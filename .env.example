APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Dipakai VerifyTiasToken middleware utk verifikasi identitas lewat tias-backend
# (GET /profile/getDataPribadi) -- lihat app/Http/Middleware/VerifyTiasToken.php.
TIAS_BACKEND_API_URL=https://api-tias.ti.ft.uika-bogor.ac.id

# Dipakai SiakV2Matkul utk ambil nama matakuliah dari SIAK v2 (AkademikController@listAbsenMatkul
# & PembelajaranController@index) -- siak_course lokal (second_db/SIAK v1) sudah tidak
# disinkron sejak migrasi v2. PENTING: dari server fts-absen, domain publik
# (api-siak.uika-bogor.ac.id) KENA FIREWALL -- WAJIB pakai IP lokal be-siakad
# (contoh produksi: https://172.16.18.190/api), bukan domain, atau semua lookup akan timeout.
SIAK_V2_API_URL=https://172.16.18.190/api
